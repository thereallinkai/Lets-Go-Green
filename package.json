{
  "name": "lets-go-green",
  "version": "1.0.0-beta.6",
  "private": true,
  "description": "Let's Go Green! is a calm, safety-aware meal planning and habit tracking application.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thereallinkai/Lets-Go-Green.git"
  },
  "bugs": {
    "url": "https://github.com/thereallinkai/Lets-Go-Green/issues"
  },
  "homepage": "https://github.com/thereallinkai/Lets-Go-Green#readme",
  "engines": {
    "node": "22.23.1"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "postinstall": "node scripts/prepare-ocr-assets.mjs",
    "ocr:assets": "node scripts/prepare-ocr-assets.mjs",
    "ocr:assets:check": "node scripts/prepare-ocr-assets.mjs --check",
    "doctor": "./scripts/doctor",
    "doctor:native": "./scripts/doctor-native",
    "launcher:install": "./scripts/install-local-launcher",
    "bootstrap": "./scripts/bootstrap",
    "services:start": "./scripts/services-start",
    "db:sync": "./scripts/sync-local-database",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:native": "./scripts/dev-native",
    "dev:all": "./scripts/dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "./scripts/test-db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prebuild": "npm run ocr:assets:check",
    "build": "next build",
    "audit:security": "npm audit --audit-level=high",
    "start": "next start --hostname 0.0.0.0",
    "verify:app": "npm run audit:security && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "verify": "npm run audit:security && npm run typecheck && npm run lint && npm run test && npm run test:db && npm run db:types:check && npm run build && npm run test:e2e",
    "db:reset": "./scripts/db-reset",
    "db:types": "./scripts/generate-database-types > src/types/database.ts",
    "db:types:check": "./scripts/check-database-types",
    "down": "./scripts/down",
    "openai:smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/openai-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "openai": "6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "ws": "8.21.1"
  }
}
