{
  "name": "lets-go-green",
  "version": "1.0.0-beta.5",
  "private": true,
  "description": "Let's Go Green! is a calm, safety-aware meal planning and habit tracking application.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thereallinkai/Lets-Go-Green.git"
  },
  "bugs": {
    "url": "https://github.com/thereallinkai/Lets-Go-Green/issues"
  },
  "homepage": "https://github.com/thereallinkai/Lets-Go-Green#readme",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "doctor": "./scripts/doctor",
    "bootstrap": "./scripts/bootstrap",
    "services:start": "./scripts/services-start",
    "db:sync": "./scripts/sync-local-database",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:all": "./scripts/dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "./scripts/test-db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "next build",
    "audit:security": "npm audit --audit-level=high",
    "start": "next start --hostname 0.0.0.0",
    "verify:app": "npm run audit:security && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "verify": "npm run audit:security && npm run typecheck && npm run lint && npm run test && npm run test:db && npm run db:types:check && npm run build && npm run test:e2e",
    "db:reset": "./scripts/db-reset",
    "db:types": "./scripts/generate-database-types > src/types/database.ts",
    "db:types:check": "./scripts/check-database-types",
    "down": "./scripts/down",
    "openai:smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/openai-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "openai": "6.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.83.0",
    "recharts": "3.10.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "supabase": "2.113.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "next": "16.2.11",
    "fast-uri": "4.1.2",
    "js-yaml": "5.2.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  }
}
