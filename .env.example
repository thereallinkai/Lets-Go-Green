# Let's Go Green! environment contract
#
# `npm run bootstrap` creates an ignored `.env.local` with local Supabase
# values. The examples below are documentation, not working production secrets.
# Never commit `.env.local` or place server credentials in NEXT_PUBLIC_* values.

# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser client. Bootstrap fills these from the local CLI.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=generated-by-local-supabase

# Server-only Supabase and PostgreSQL values. Bootstrap fills these locally.
SUPABASE_SERVICE_ROLE_KEY=generated-by-local-supabase
DATABASE_URL=generated-by-local-supabase

# Local development tools
SUPABASE_STUDIO_URL=http://127.0.0.1:54323
SUPABASE_EMAIL_CAPTURE_URL=http://127.0.0.1:54324
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Bootstrap derives this local Supabase Auth callback automatically. In a
# Codespace it uses the runtime-provided forwarding domain and writes the value
# to ignored supabase/.env; manual setup is not required.
LETS_GO_GREEN_AUTH_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

# AI is deterministic and free by default.
AI_PROVIDER=mock
ENABLE_REAL_AI=false

# Optional server-only OpenAI configuration. Real AI is enabled only when all
# three values are valid and ENABLE_REAL_AI is explicitly set to true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REQUEST_TIMEOUT_MS=30000

# Optional server-only USDA FoodData Central lookup. Local development falls
# back to USDA's rate-limited DEMO_KEY when this value is omitted.
USDA_FDC_API_KEY=

# Required identification for server-to-server food-source requests. Keep a
# working project URL or operator contact in production.
FOOD_LOOKUP_USER_AGENT=LetsGoGreen/1.0.0-beta.5 (https://github.com/thereallinkai/Lets-Go-Green)
