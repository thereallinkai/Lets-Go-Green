#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT_DIR"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

command -v node >/dev/null 2>&1 \
  || fail "Node.js is required. Install the exact version in .nvmrc, then retry."
command -v npm >/dev/null 2>&1 \
  || fail "npm is required. Install the version recorded in package.json, then retry."

EXPECTED_NODE="$(tr -d '[:space:]' < .nvmrc 2>/dev/null || true)"
NODE_VERSION_PIN="$(tr -d '[:space:]' < .node-version 2>/dev/null || true)"
[[ -n "$EXPECTED_NODE" && "$EXPECTED_NODE" == "$NODE_VERSION_PIN" ]] \
  || fail ".nvmrc and .node-version must record the same exact Node.js version."

ACTUAL_NODE="$(node -p 'process.versions.node')"
[[ "$ACTUAL_NODE" == "$EXPECTED_NODE" ]] \
  || fail "Node.js ${EXPECTED_NODE} is required; found ${ACTUAL_NODE}. Run 'nvm install && nvm use', then retry."

EXPECTED_NPM="$(
  node -p '
    const value = require("./package.json").packageManager;
    const match = typeof value === "string" ? /^npm@(\d+\.\d+\.\d+)$/.exec(value) : null;
    match?.[1] ?? "";
  ' 2>/dev/null || true
)"
[[ -n "$EXPECTED_NPM" ]] \
  || fail "package.json must record an exact npm packageManager such as npm@10.9.8."

ACTUAL_NPM="$(npm --version)"
[[ "$ACTUAL_NPM" == "$EXPECTED_NPM" ]] \
  || fail "npm ${EXPECTED_NPM} is required; found ${ACTUAL_NPM}. Install the packageManager version recorded in package.json, then retry."

DEPENDENCIES_READY=false
if [[ -x node_modules/.bin/next ]] \
  && npm ls --depth=0 --json >/dev/null 2>&1 \
  && node -e '
    for (const packageName of [
      "tesseract.js",
      "tesseract.js-core",
      "@tesseract.js-data/eng",
    ]) require.resolve(`${packageName}/package.json`);
  ' >/dev/null 2>&1; then
  DEPENDENCIES_READY=true
fi

if [[ "$DEPENDENCIES_READY" != true ]]; then
  printf 'Installing exact project dependencies from package-lock.json...\n'
  npm ci
elif ! node scripts/prepare-ocr-assets.mjs --check >/dev/null 2>&1; then
  npm run ocr:assets
fi

APP_PORT="${PORT:-3000}"
APP_ORIGIN="http://127.0.0.1:${APP_PORT}"

# Exported empty values intentionally take precedence over any container/local
# Supabase values in .env.local. This command is a clearly labeled,
# credential-free UI/demo mode and never silently talks to a database.
export NEXT_PUBLIC_APP_URL="$APP_ORIGIN"
export NEXT_PUBLIC_SUPABASE_URL=""
export NEXT_PUBLIC_SUPABASE_ANON_KEY=""
export SUPABASE_SERVICE_ROLE_KEY=""
export DATABASE_URL=""
export AI_PROVIDER="mock"
export ENABLE_REAL_AI="false"
export OPENAI_API_KEY=""
export LETS_GO_GREEN_NATIVE_PROJECT_ID="$(
  node -e '
    const { createHash } = require("node:crypto");
    const { realpathSync } = require("node:fs");
    process.stdout.write(
      createHash("sha256").update(realpathSync(process.cwd())).digest("hex"),
    );
  '
)"

printf "Starting Let's Go Green! native demo at %s\n" "$APP_ORIGIN"
printf 'No container or Docker daemon is used. Demo changes reset when the process restarts.\n'
printf 'Press Ctrl+C to stop.\n'

exec ./node_modules/.bin/next dev \
  --hostname 127.0.0.1 \
  --port "$APP_PORT" \
  "$@"
